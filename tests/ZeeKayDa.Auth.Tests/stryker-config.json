{
  "stryker-config": {
    "project": "ZeeKayDa.Auth.csproj",
    "test-runner": "mtp",
    "ignore-methods": [
      "ConfigureAwait",
      "GC.SuppressFinalize",
      "*Exception.ctor"
    ],
    "mutate": [
      "**/Tokens/**/*.cs",
      "**/Security/**/*.cs",
      "**/Clients/**/*.cs",
      "**/Authorization/**/*.cs"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ]
  }
}
