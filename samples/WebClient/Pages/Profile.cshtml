@page
@{
    ViewData["Title"] = "Profile";
}
<h1>Hello, @User.Identity?.Name</h1>
<p>These are the claims the identity server released: <code>sub</code> from the ID token, the rest
from the userinfo endpoint, which is where OpenID Connect Core &#167;5.4 puts them.</p>
<table id="claims">
    <thead>
        <tr><th>Type</th><th>Value</th></tr>
    </thead>
    <tbody>
        @foreach (var claim in User.Claims)
        {
            <tr><th>@claim.Type</th><td>@claim.Value</td></tr>
        }
    </tbody>
</table>
<p><a href="/">Home</a></p>
