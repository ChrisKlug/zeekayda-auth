<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — ZeeKayDa sample web client</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 3rem auto; padding: 0 1rem; color: #222; }
        button { margin-top: 1.25rem; padding: .5rem 1rem; }
        table { border-collapse: collapse; }
        th, td { text-align: left; padding: .25rem .75rem .25rem 0; vertical-align: top; }
        td { font-family: ui-monospace, monospace; word-break: break-all; }
    </style>
</head>
<body>
    <main>
        @RenderBody()
    </main>
</body>
</html>
