@page
@{
    ViewData["Title"] = "Home";
}
<h1>ZeeKayDa sample web client</h1>
@if (User.Identity?.IsAuthenticated == true)
{
    <p>Signed in as <strong id="user-name">@User.Identity.Name</strong>.</p>
    <p><a href="/profile">See your claims</a></p>
    <form method="post" asp-page="/SignOut">
        <button type="submit">Sign out</button>
    </form>
}
else
{
    <p>
        You are not signed in. Opening the profile page sends you to the sample identity server to
        sign in.
    </p>
    <p><a href="/profile">Sign in</a></p>
}
