{
  "Kestrel": {
    "Endpoints": {
      "Https": {
        // Bound to every interface, not to the issuer's hostname: the conformance suite's Java
        // server reaches this machine over the Docker bridge, which is not an address
        // zeekayda.localtest.me resolves to.
        "Url": "https://*:5443",
        // Generated by conformance/make-certs.sh, and trusted by the suite's Java server because
        // its CA is baked into conformance/Dockerfile.suite-server. Relative to the content root.
        "Certificate": {
          "Path": "../../conformance/certs/server.pem",
          "KeyPath": "../../conformance/certs/server.key"
        }
      }
    }
  },
  "IdentityServer": {
    // A hostname rather than localhost, so that the suite's containers and a browser on this
    // machine can both reach the issuer at the single URL the discovery document advertises.
    // localtest.me is public DNS pointing at 127.0.0.1, so no hosts-file entry is needed.
    "Issuer": "https://zeekayda.localtest.me:5443",
    "Clients": [
      {
        "ClientId": "sample-public-client",
        "RedirectUris": [ "https://localhost:5002/signin-oidc" ],
        "PostLogoutRedirectUris": [ "https://localhost:5002/signout-callback-oidc" ],
        "Scopes": [ "openid", "profile", "email" ]
      },
      {
        "ClientId": "conformance-client",
        "Secret": "conformance-client-secret",
        "RedirectUris": [ "https://localhost.emobix.co.uk:8443/test/a/zeekayda/callback" ],
        "Scopes": [ "openid", "profile", "email", "address", "phone" ],
        "RequireConsent": false
      },
      {
        "ClientId": "conformance-client2",
        "Secret": "conformance-client2-secret",
        "RedirectUris": [ "https://localhost.emobix.co.uk:8443/test/a/zeekayda/callback" ],
        "Scopes": [ "openid", "profile", "email", "address", "phone" ],
        "RequireConsent": false
      }
    ]
  }
}
