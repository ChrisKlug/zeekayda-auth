<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — ZeeKayDa sample identity server</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 28rem; margin: 3rem auto; padding: 0 1rem; color: #222; }
        label { display: block; margin-top: 1rem; }
        input { width: 100%; padding: .5rem; box-sizing: border-box; }
        button { margin-top: 1.25rem; padding: .5rem 1rem; }
        .error { color: #b00020; }
        ul.scopes { padding-left: 1.25rem; }
    </style>
</head>
<body>
    <main>
        @RenderBody()
    </main>
</body>
</html>
