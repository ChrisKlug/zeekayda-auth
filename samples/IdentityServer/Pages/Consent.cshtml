@page "/consent"
@model ConsentModel
@{
    ViewData["Title"] = "Allow access";
}
@if (Model.ConsentRequest is not { } request)
{
    <h1>Nothing to allow</h1>
    <p>This request has expired or was already answered. Return to the application and sign in again.</p>
    return;
}
<h1>Allow access?</h1>

<p><strong>@(request.Client.DisplayName ?? request.Client.ClientId)</strong> is asking for:</p>
<ul class="scopes">
    @foreach (var scope in request.Scopes)
    {
        <li>@scope</li>
    }
</ul>

<form method="post">
    @foreach (var scope in request.Scopes)
    {
        <input type="hidden" name="scope" value="@scope" />
    }
    <button id="consent-submit" class="login-submit" type="submit" name="action" value="allow">Allow</button>
    <button id="consent-deny" type="submit" name="action" value="deny">Deny</button>
</form>
