@page "/consent"
@model ConsentModel
@{
    ViewData["Title"] = "Allow access";
}
<h1>Allow access?</h1>

<p><strong>@(Model.ConsentRequest.Client.DisplayName ?? Model.ConsentRequest.Client.ClientId)</strong> is asking for:</p>
<ul class="scopes">
    @foreach (var scope in Model.ConsentRequest.Scopes)
    {
        <li>@scope</li>
    }
</ul>

<form method="post">
    <button id="consent-submit" class="login-submit" type="submit" name="action" value="allow">Allow</button>
    <button id="consent-deny" type="submit" name="action" value="deny">Deny</button>
</form>
