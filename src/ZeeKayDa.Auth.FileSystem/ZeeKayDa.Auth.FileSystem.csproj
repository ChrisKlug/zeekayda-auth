<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ZeeKayDa.Auth.FileSystem</PackageId>
    <!-- Required by [LibraryImport] source generator, which emits unsafe marshaling stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Cross-platform file-based (PEM/PFX) JWT signing provider for ZeeKayDa.Auth: loads an X.509 certificate and private key from operator-supplied files and signs locally.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ZeeKayDa.Auth/ZeeKayDa.Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/ProcessIdentityHelper.cs" Link="ProcessIdentityHelper.cs" />
    <Compile Include="../Shared/Pkcs12PrivateKey.cs" Link="Pkcs12PrivateKey.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- A PKCS#12 private key is imported in memory, never through an OS-backed certificate. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../Shared/BannedSymbols.Pkcs12.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ZeeKayDa.Auth.Analyzers/ZeeKayDa.Auth.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tracks this project's public surface in PublicAPI.Shipped.txt/PublicAPI.Unshipped.txt -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
