<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ZeeKayDa.Auth.TestKit</PackageId>
    <Description>Test kit for ZeeKayDa.Auth extension points, usable without internal access to ZeeKayDa.Auth itself: ready-to-derive xUnit base classes that let a backing-store author prove their implementation against the framework's invariants, and a signing key ring harness that lets a signing key source's tests drive the ring that reads it on a fake clock, and a factory for the redacting logger a component under test takes.</Description>
    <!-- CS1591 (missing XML doc) is suppressed for [Fact]/[Theory] test methods only: per this
         repo's test-standards convention, a test method's readable-English-sentence name IS its
         documentation; the abstract/virtual members a consumer actually overrides keep full XML
         docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ZeeKayDa.Auth/ZeeKayDa.Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ZeeKayDa.Auth.Analyzers/ZeeKayDa.Auth.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tracks this project's public surface in PublicAPI.Shipped.txt/PublicAPI.Unshipped.txt -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
